---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localizedPath } from '../../i18n/utils';

const lang = 'zh' as const;
const t = useTranslations(lang);

const allPosts = await getCollection('posts', ({ data }) => data.lang === lang && !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);
const projects = allProjects
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order)
  .slice(0, 3);

const links = [
  { href: localizedPath('/posts', lang), label: '文章' },
  { href: localizedPath('/projects', lang), label: '项目' },
];
---
<BaseLayout description={t('site.tagline')}>
  {/* Hero */}
  <section class="min-h-screen flex flex-col items-center justify-center p-4 relative z-10">
    <div class="flex flex-col items-center gap-8 mb-20 animate-in">
      <div class="relative group">
        <div class="absolute inset-0 bg-neon-pink/20 blur-xl rounded-full opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div transition:name="brand-logo" class="scale-[2.5] mb-8 origin-center relative">
          <BrandLogo />
        </div>
      </div>

      <h1 class="text-5xl md:text-7xl font-extrabold text-text-white tracking-tighter mb-2 text-center dark:drop-shadow-2xl">
        {t('home.hero.name')}
      </h1>
      <p class="text-xl text-text-muted mb-10 text-center max-w-lg font-light tracking-wide">
        探索技术与表达的可能
      </p>

      <nav class="glass-nav rounded-full px-8 py-4 sm:px-10 sm:py-5 flex gap-6 sm:gap-10 items-center border border-[var(--c-line-strong)] shadow-[0_8px_32px_var(--c-shadow-strong)] backdrop-blur-2xl hover:scale-105 transition-transform duration-300">
        {links.map((link) => (
          <a href={link.href} class="text-base sm:text-lg font-bold text-text-white hover:text-neon-pink transition-colors relative group">
            {link.label}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-neon-pink transition-all duration-300 group-hover:w-full shadow-[0_0_10px_#e74dae]"></span>
          </a>
        ))}
        <div class="w-px h-6 bg-[var(--c-line-strong)] mx-1 sm:mx-2"></div>
        <a href="/en/" class="text-xs sm:text-sm font-bold bg-[var(--c-tint)] px-3 py-1 sm:px-4 sm:py-1.5 rounded-full text-text-white hover:bg-neon-pink transition-all border border-[var(--c-line-strong)] hover:shadow-[0_0_15px_#e74dae]">
          EN
        </a>
      </nav>
    </div>

    <div class="absolute bottom-10 animate-bounce text-text-white/30 hover:text-text-white transition-colors cursor-pointer">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </div>
  </section>

  {/* Content */}
  <section class="max-w-7xl mx-auto px-4 py-24 w-full bg-void-black/80 backdrop-blur-xl rounded-t-[3rem] min-h-screen border-t border-[var(--c-line)] shadow-[0_-10px_40px_var(--c-shadow-strong)] z-20 relative -mt-10">
    {posts.length > 0 && (
      <div class="mb-24">
        <div class="flex items-center justify-between mb-12">
          <h2 class="text-3xl font-bold flex items-center gap-4 text-text-white">
            <span class="w-2 h-8 bg-neon-pink rounded-full shadow-[0_0_15px_#e74dae]"></span>
            精选文章
          </h2>
          <a href={localizedPath('/posts', lang)} class="text-sm font-semibold text-text-muted hover:text-neon-pink transition-colors">查看全部 →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => <PostCard post={post} lang={lang} />)}
        </div>
      </div>
    )}

    {projects.length > 0 && (
      <div>
        <div class="flex items-center justify-between mb-12">
          <h2 class="text-3xl font-bold flex items-center gap-4 text-text-white">
            <span class="w-2 h-8 bg-neon-pink rounded-full shadow-[0_0_15px_#e74dae]"></span>
            近期项目
          </h2>
          <a href={localizedPath('/projects', lang)} class="text-sm font-semibold text-text-muted hover:text-neon-pink transition-colors">查看全部 →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
