---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<BaseLayout title={t('404.title')}>
  <section class="max-w-[1120px] mx-auto px-5 md:px-8 pt-24 md:pt-32">
    <p class="text-sm text-muted tnum">404</p>
    <h1 class="mt-3 text-[32px] md:text-[40px] font-bold tracking-tight text-fg">{t('404.title')}</h1>
    <p class="mt-3 text-fg-2">{t('404.body')}</p>
    <a href={localizedPath('/', lang)} class="inline-block mt-8 text-fg border-b border-accent pb-0.5 hover:text-accent transition-colors">{t('404.cta')} →</a>
  </section>
</BaseLayout>
