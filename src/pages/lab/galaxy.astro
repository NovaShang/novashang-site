---
// Tuning page for the galaxy renderer: same framing as the Mountain Lion wallpaper.
---
<html><body style="margin:0;background:#000">
<canvas id="c" style="display:block;width:100vw;height:100vh"></canvas>
<script>
  import { mountGalaxy } from '../../lib/galaxy/galaxy';
  const g = mountGalaxy(document.getElementById('c') as HTMLCanvasElement, {
    center: () => [-0.02, 0.12],
    frameWidth: () => 2.5,
    onReady: () => document.body.dataset.ready = '1',
  });
  (window as any).galaxy = g;
</script>
</body></html>
