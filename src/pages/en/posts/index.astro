---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const posts = (await getCollection('posts', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<BaseLayout title={t('posts.title')}>
  <section class="max-w-7xl mx-auto px-4 pt-32 pb-24 w-full relative z-10">
    <div class="mb-16 animate-in">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tighter text-text-white mb-4 flex items-center gap-4">
        <span class="w-2 h-12 bg-neon-pink rounded-full shadow-[0_0_20px_#e74dae]"></span>
        Writing
      </h1>
      <p class="text-text-muted text-lg max-w-xl">{t('posts.subtitle')}</p>
    </div>

    {posts.length === 0 ? (
      <p class="text-text-muted">{t('posts.empty')}</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => <PostCard post={post} lang={lang} />)}
      </div>
    )}
  </section>
</BaseLayout>
