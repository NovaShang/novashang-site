---
import type { CollectionEntry } from 'astro:content';
import { displayUrl } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, description, url } = project.data;
---
<a href={url} target="_blank" rel="noopener noreferrer" class="row group block py-5">
  <div class="flex items-baseline justify-between gap-6">
    <h3 class="text-[17px] font-medium text-fg group-hover:text-white transition-colors">{title}</h3>
    <span class="hidden sm:block shrink-0 text-[13px] text-muted group-hover:text-fg-2 transition-colors">{displayUrl(url)} ↗</span>
  </div>
  <p class="mt-1.5 text-[15px] leading-relaxed text-fg-2/80 group-hover:text-fg-2 transition-colors">{description}</p>
</a>
