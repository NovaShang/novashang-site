---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: 'zh' | 'en';
}
const { project, lang } = Astro.props;
const { title, description } = project.data;
const { url } = project.data;
const cta = lang === 'zh' ? '访问项目 →' : 'Visit →';
---
<a href={url} target="_blank" rel="noopener noreferrer" class="group block h-full">
  <article class="glass-panel p-6 rounded-xl hover:border-neon-pink/50 transition-all duration-300 h-full flex flex-col relative overflow-hidden group-hover:shadow-[0_0_20px_rgba(231,77,174,0.15)]">
    <div class="absolute inset-0 bg-gradient-to-br from-neon-pink/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
    <h3 class="text-xl font-bold mb-2 text-text-white group-hover:text-neon-pink transition-colors relative z-10">{title} <span class="text-sm opacity-60" aria-hidden="true">↗</span></h3>
    <p class="text-text-muted text-sm relative z-10 line-clamp-3 mb-4">{description}</p>
    <div class="mt-auto pt-2 text-neon-pink text-xs font-bold uppercase tracking-widest relative z-10 flex items-center gap-2 opacity-80 group-hover:opacity-100 transition-opacity">
      <span class="group-hover:translate-x-1 transition-transform duration-300">{cta}</span>
    </div>
  </article>
</a>
