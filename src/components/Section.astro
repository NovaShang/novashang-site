---
// One band of the page: a narrow label column on the left, content on the
// right. Stacks on phones.
interface Props {
  label: string;
  /** Optional link under the label, e.g. "all writing". */
  more?: { href: string; text: string };
  /** Use h1 for the label (page titles). */
  title?: boolean;
  note?: string;
}
const { label, more, title = false, note } = Astro.props;
const Tag = title ? 'h1' : 'h2';
---
<section class="max-w-[1120px] mx-auto px-5 md:px-8 grid md:grid-cols-[220px_1fr] gap-x-12 gap-y-5">
  <div class="md:pt-6">
    <div class="md:sticky md:top-24">
      <Tag class:list={[title ? 'text-[30px] md:text-[34px] font-semibold tracking-tight text-fg' : 'text-[15px] font-medium text-fg-2']}>{label}</Tag>
      {note && <p class="mt-3 text-[14px] leading-relaxed text-muted max-w-[220px]">{note}</p>}
      {more && <a href={more.href} class="hidden md:inline-block mt-3 text-[13px] text-muted hover:text-fg transition-colors">{more.text} →</a>}
    </div>
  </div>
  <div class="min-w-0">
    <slot />
    {more && <a href={more.href} class="md:hidden inline-block mt-5 text-[13px] text-muted">{more.text} →</a>}
  </div>
</section>
