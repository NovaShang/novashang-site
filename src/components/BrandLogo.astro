---
// The magenta tile from the hand-written sites. It lives outside the page
// content and persists across navigations, so it can fly between its two
// homes: a large tile above the name on the landing page, and the corner
// tab in the nav on every page (see src/lib/brand.ts).
import { getLangFromUrl, localizedPath, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<a href={localizedPath('/', lang)} aria-label={t('site.title')} class="brand" data-brand transition:persist="brand">
  <span class="brand-tile" data-brand-tile></span>
  <svg class="brand-mark" data-brand-mark viewBox="0 0 30 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M18.5282 0V18.441L11.3612 11.3286L9.20972 12.2401V30.1502L11.0737 32V13.6578L18.4017 20.9297L20.3921 20.0863V1.84979L18.5282 0Z" fill="currentColor" />
    <path d="M5.06732 11.0215L0 16.0485L5.06732 21.0773V19.4429L1.6474 16.0485L5.06732 12.6555V11.0215Z" fill="currentColor" />
    <path d="M24.5682 11.055V12.6903L27.9526 16.0503L24.5682 19.409V21.0439L29.6 16.0485L24.5682 11.055Z" fill="currentColor" />
  </svg>
</a>

<script>
  import { initBrand } from '../lib/brand';
  initBrand();
</script>

<style>
  /* Both parts are positioned by transform from script; these are the
     corner-tab poses so the first paint is right even before it runs. */
  .brand {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    width: 0;
    height: 0;
  }
  .brand-tile {
    position: fixed;
    left: 0;
    top: 0;
    width: 104px;
    height: 104px;
    border-radius: 14px;
    background: #e74dae;
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.35);
    transform-origin: 52px 52px;
    transform: translate(-46px, -44px) rotate(-15deg) scale(0.8077);
    will-change: transform;
  }
  .brand-mark {
    position: fixed;
    left: 0;
    top: 0;
    width: 30px;
    height: 32px;
    color: #fff;
    transform-origin: 15px 16px;
    transform: translate(12.5px, 2.8px) scale(0.8667);
    will-change: transform;
    pointer-events: none;
  }
  /* on the landing page the tile starts in the galaxy scene; hide this copy
     until it's placed, and whenever the scene is drawing it */
  :global(body[data-shot='home']) .brand:not(.is-placed),
  .brand.in-scene { opacity: 0; }
  .brand.in-scene .brand-tile { pointer-events: none; }
  @media (min-width: 768px) {
    .brand-tile { transform: translate(-42px, -40px) rotate(-15deg); }
    .brand-mark { transform: translate(23.6px, 10.1px); }
  }
</style>
