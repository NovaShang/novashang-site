---
// The magenta tile from the 2024 hand-written site: a tilted rounded square
// tucked into the top-left corner of the page, with the <N> mark upright inside.
---
<span class="brand-tile" aria-hidden="true">
  <svg class="brand-mark" viewBox="0 0 30 32" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M18.5282 0V18.441L11.3612 11.3286L9.20972 12.2401V30.1502L11.0737 32V13.6578L18.4017 20.9297L20.3921 20.0863V1.84979L18.5282 0Z" fill="currentColor" />
    <path d="M5.06732 11.0215L0 16.0485L5.06732 21.0773V19.4429L1.6474 16.0485L5.06732 12.6555V11.0215Z" fill="currentColor" />
    <path d="M24.5682 11.055V12.6903L27.9526 16.0503L24.5682 19.409V21.0439L29.6 16.0485L24.5682 11.055Z" fill="currentColor" />
  </svg>
</span>

<style>
  .brand-tile {
    position: absolute;
    left: -36px;
    top: -34px;
    width: 84px;
    height: 84px;
    border-radius: 12px;
    background: #e74dae;
    transform: rotate(-15deg);
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.35);
  }
  .brand-mark {
    position: absolute;
    right: 11px;
    bottom: 12px;
    width: 26px;
    height: 28px;
    color: #fff;
    transform: rotate(15deg);
  }
  @media (min-width: 768px) {
    .brand-tile { left: -42px; top: -40px; width: 104px; height: 104px; border-radius: 14px; }
    .brand-mark { right: 13px; bottom: 15px; width: 30px; height: 32px; }
  }
</style>
