---
import { getLangFromUrl, localizedPath, switchLangPath, useTranslations } from '../i18n/utils';
import AuthMenu from './AuthMenu.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;

const links = [
  { href: localizedPath('/posts', lang), label: t('nav.posts'), match: 'posts' },
  { href: localizedPath('/projects', lang), label: t('nav.projects'), match: 'projects' },
];

const isActive = (match: string) => path.startsWith(`/${lang}/${match}`);

const targetLang = lang === 'zh' ? 'en' : 'zh';
const switchUrl = switchLangPath(path, lang, targetLang);
---
<header class="always-dark fixed top-0 inset-x-0 z-50 h-13 md:h-14 bg-nav text-fg" style="box-shadow: var(--c-nav-shadow)">
  <div class="h-full flex items-center justify-between pl-[72px] md:pl-[92px] pr-3 md:pr-6">
    <a href={localizedPath('/', lang)} data-nav-title class="text-[16px] md:text-[17px] font-semibold text-fg tracking-tight">
      {t('home.hero.name')}
    </a>

    <nav class="flex items-center gap-1 md:gap-2 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'px-2 md:px-3 py-1.5 transition-colors',
            isActive(link.match) ? 'text-fg' : 'text-fg-2 hover:text-fg',
          ]}
          aria-current={isActive(link.match) ? 'page' : undefined}
        >
          <span class:list={['pb-1', isActive(link.match) && 'border-b-2 border-accent']}>{link.label}</span>
        </a>
      ))}
      <span class="w-px h-4 bg-line mx-1 md:mx-2"></span>
      <a
        href={switchUrl}
        class="px-1.5 md:px-2 py-1.5 text-muted hover:text-fg transition-colors"
        aria-label={targetLang === 'en' ? 'Switch to English' : '切换到中文'}
      >
        {lang === 'zh' ? 'EN' : '中文'}
      </a>
      <ThemeToggle />
      <span class="hidden md:inline-flex ml-1"><AuthMenu /></span>
    </nav>
  </div>
</header>
<div class="h-13 md:h-14" aria-hidden="true"></div>
