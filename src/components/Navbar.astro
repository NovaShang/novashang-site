---
import { getLangFromUrl, isHomePath, localizedPath, switchLangPath, useTranslations } from '../i18n/utils';
import BrandLogo from './BrandLogo.astro';
import AuthMenu from './AuthMenu.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;
const onHome = isHomePath(path, lang);

const links = [
  { href: localizedPath('/posts', lang), label: t('nav.posts'), match: 'posts' },
  { href: localizedPath('/projects', lang), label: t('nav.projects'), match: 'projects' },
];

function isActive(match: string) {
  return path.includes(`/${lang}/${match}`);
}

const targetLang = lang === 'zh' ? 'en' : 'zh';
const switchUrl = switchLangPath(path, lang, targetLang);
---
<nav class="fixed top-0 left-0 w-full z-50 glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    {/* Brand — hide logo on home so the hero logo is the only brand-logo target */}
    <a href={localizedPath('/', lang)} class="flex items-center gap-2 group" aria-label={t('site.title')}>
      {!onHome && (
        <div transition:name="brand-logo" class="scale-75 origin-left">
          <BrandLogo />
        </div>
      )}
      <span class="font-extrabold text-xl tracking-tighter text-text-white group-hover:text-neon-pink transition-colors">{t('home.hero.name')}</span>
    </a>

    {/* Center links */}
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => {
        const active = isActive(link.match);
        return (
          <a
            href={link.href}
            class:list={[
              'relative py-2 text-sm font-semibold transition-colors',
              active ? 'text-text-white' : 'text-text-muted hover:text-neon-pink',
            ]}
          >
            {link.label}
            {active && (
              <span
                transition:name="active-indicator"
                class="absolute bottom-0 left-0 w-full h-0.5 bg-neon-pink shadow-[0_0_8px_rgba(231,77,174,0.8)]"
              ></span>
            )}
          </a>
        );
      })}
    </div>

    {/* Right utilities */}
    <div class="flex items-center gap-3">
      <AuthMenu />
      <ThemeToggle />
      <a
        href={switchUrl}
        class="text-xs font-bold bg-midnight-panel px-2 py-1 rounded hover:bg-neon-pink hover:text-white transition-colors border border-[var(--c-line-strong)] text-text-white"
        aria-label={targetLang === 'en' ? 'Switch to English' : '切换到中文'}
      >
        {lang === 'zh' ? 'EN' : 'CN'}
      </a>
      <a
        href="https://github.com/NovaShang"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="hover:text-neon-pink transition-colors text-text-muted"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>

  {/* Mobile links */}
  <div class="flex md:hidden justify-center items-center gap-6 px-4 py-2 border-t border-[var(--c-line)]">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'text-xs font-semibold',
          isActive(link.match) ? 'text-text-white' : 'text-text-muted',
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>
