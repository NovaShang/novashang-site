---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from './PostRow.astro';
import ProjectRow from './ProjectRow.astro';
import Section from './Section.astro';
import { localizedPath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = (await getCollection('posts', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

---
<BaseLayout shot="home">
  {/* The first screen is the scene itself: the galaxy, the tile at its core,
      and a small caption like the label beside a work on a gallery wall. */}
  <section class="relative h-[100svh] min-h-[560px]">
    <div class="absolute inset-x-0 bottom-0">
      <div class="caption max-w-[1120px] mx-auto px-5 md:px-8 pb-9 md:pb-12">
        <h1 class="text-[22px] md:text-[24px] font-semibold tracking-tight text-white">
          {t('home.hero.name')}<span class="ml-3 font-normal text-white/45">{t('home.hero.alt')}</span>
        </h1>
        <p class="mt-1.5 text-[14px] md:text-[15px] text-white/65">{t('home.hero.role')}</p>
      </div>
    </div>
  </section>

  <div class="pt-24 md:pt-32 space-y-24 md:space-y-32">
    {posts.length > 0 && (
      <Section label={t('home.section.posts')} more={{ href: localizedPath('/posts', lang), text: t('home.posts.all') }}>
        <div class="divide-y divide-line border-b border-line">
          {posts.map((post) => <PostRow post={post} lang={lang} />)}
        </div>
      </Section>
    )}

    <Section label={t('home.section.projects')} more={{ href: localizedPath('/projects', lang), text: t('home.projects.all').replace('{n}', String(allProjects.length)) }}>
      <div class="divide-y divide-line border-b border-line">
        {featured.map((project) => <ProjectRow project={project} />)}
      </div>
    </Section>
  </div>
</BaseLayout>

<style>
  .caption { text-shadow: 0 1px 14px rgba(7, 13, 18, 0.7); }
</style>
