---
import type { CollectionEntry } from 'astro:content';
import { formatDate, type Lang } from '../i18n/utils';
import { media } from '../lib/variant';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const { title, description, pubDate, tags, heroImage } = post.data;
const href = `/${lang}/posts/${post.id.split('/').pop()}`;
const meta = [formatDate(pubDate, lang), ...tags.slice(1)].join(' · ');
const image = media(heroImage);
---
<a href={href} class="card group grid sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] overflow-hidden">
  {image && (
    <div class="aspect-[16/10] sm:aspect-auto sm:min-h-[180px] overflow-hidden bg-black/30">
      <img src={image} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
    </div>
  )}
  <div class:list={['p-5 md:p-6 min-w-0', !image && 'sm:col-span-2']}>
    <p class="text-[13px] text-muted tnum">{meta}</p>
    <h3 class="mt-2 text-[18px] md:text-[19px] leading-snug font-medium text-fg group-hover:text-white transition-colors">{title}</h3>
    {description && <p class="mt-2 text-[15px] leading-relaxed text-fg-2/85 line-clamp-3">{description}</p>}
  </div>
</a>
