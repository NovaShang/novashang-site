---
import type { CollectionEntry } from 'astro:content';
import { formatDate, type Lang } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: Lang;
  /** Wide card with the hero image beside the text. */
  feature?: boolean;
}
const { post, lang, feature = false } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
const href = `/${lang}/posts/${post.id.split('/').pop()}`;
const meta = [formatDate(pubDate, lang), ...tags.slice(1)].join(' · ');
---
{feature && heroImage ? (
  <a href={href} class="panel group grid grid-cols-1 md:grid-cols-[1.15fr_1fr] overflow-hidden">
    <div class="aspect-[16/9] md:aspect-auto md:min-h-[300px] bg-bg overflow-hidden border-b md:border-b-0 md:border-r border-line">
      <img src={heroImage} alt="" loading="lazy" class="w-full h-full object-cover" />
    </div>
    <div class="p-6 md:p-8 flex flex-col">
      <p class="text-[13px] text-muted tnum">{meta}</p>
      <h3 class="panel-title mt-3 text-[20px] md:text-[24px] leading-snug font-semibold text-fg tracking-tight transition-colors">{title}</h3>
      {description && <p class="mt-3 text-[15px] leading-relaxed text-fg-2">{description}</p>}
    </div>
  </a>
) : (
  <a href={href} class="panel group block p-6">
    <p class="text-[13px] text-muted tnum">{meta}</p>
    <h3 class="panel-title mt-2.5 text-[17px] leading-snug font-semibold text-fg transition-colors">{title}</h3>
    {description && <p class="mt-2 text-[14.5px] leading-relaxed text-fg-2 line-clamp-3">{description}</p>}
  </a>
)}
