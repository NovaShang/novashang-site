---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div data-auth-menu class="relative inline-flex items-center" data-status="loading">
  <a
    data-auth-signin
    href="#"
    class="text-sm text-muted hover:text-fg transition-colors"
  >
    {t('auth.signin')}
  </a>

  <div data-auth-user class="items-center">
    <button
      type="button"
      data-auth-user-trigger
      class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-1 py-1 text-xs font-medium text-fg hover:border-accent/50 transition-colors"
    >
      <span data-auth-avatar class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent text-[10px] font-semibold text-white"></span>
      <span data-auth-name class="max-w-[6rem] truncate hidden sm:inline pr-1"></span>
    </button>
    <div
      data-auth-dropdown
      class="invisible absolute right-0 top-10 z-50 min-w-[10rem] panel p-1 text-sm opacity-0 shadow-lg transition-opacity"
    >
      <button
        type="button"
        data-auth-signout
        class="block w-full rounded-md px-3 py-2 text-left text-fg-2 hover:bg-surface-hover hover:text-fg transition-colors text-sm"
      >
        {t('auth.signout')}
      </button>
    </div>
  </div>
</div>

<style>
  [data-auth-menu] [data-auth-signin],
  [data-auth-menu] [data-auth-user] { display: none; }
  [data-auth-menu][data-status="guest"] [data-auth-signin],
  [data-auth-menu][data-status="loading"] [data-auth-signin] { display: inline; }
  [data-auth-menu][data-status="authed"] [data-auth-user] { display: inline-flex; }
</style>

<script>
  import { fetchSession, signOut, loginUrl } from '../lib/auth';

  const SESSION_CACHE_KEY = 'nova:session:v1';

  function readCached() {
    try {
      const raw = sessionStorage.getItem(SESSION_CACHE_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch { return null; }
  }
  function writeCached(s: unknown) {
    try {
      if (s) sessionStorage.setItem(SESSION_CACHE_KEY, JSON.stringify(s));
      else sessionStorage.removeItem(SESSION_CACHE_KEY);
    } catch { /* ignore */ }
  }
  function initials(name: string) {
    if (!name) return '?';
    const parts = name.trim().split(/\s+/);
    return ((parts[0]?.[0] ?? '') + (parts[1]?.[0] ?? '')).toUpperCase() || name[0]!.toUpperCase();
  }

  function render(menu: HTMLElement, session: { user: { name: string; email: string; image?: string | null } } | null) {
    const signinEl = menu.querySelector<HTMLAnchorElement>('[data-auth-signin]');
    const avatarEl = menu.querySelector<HTMLElement>('[data-auth-avatar]');
    const nameEl = menu.querySelector<HTMLElement>('[data-auth-name]');

    if (session) {
      menu.dataset.status = 'authed';
      const display = session.user.name || session.user.email;
      if (nameEl) nameEl.textContent = display;
      if (avatarEl) {
        if (session.user.image) {
          avatarEl.innerHTML = `<img src="${session.user.image}" alt="" class="h-6 w-6 rounded-full object-cover" />`;
        } else {
          avatarEl.textContent = initials(display);
        }
      }
    } else {
      menu.dataset.status = 'guest';
      if (signinEl) signinEl.href = loginUrl(window.location.href);
    }
  }

  function wireDropdown(menu: HTMLElement) {
    const trigger = menu.querySelector<HTMLButtonElement>('[data-auth-user-trigger]');
    const dropdown = menu.querySelector<HTMLElement>('[data-auth-dropdown]');
    if (!trigger || !dropdown) return;

    const open = () => { dropdown.classList.remove('invisible', 'opacity-0'); dropdown.classList.add('opacity-100'); };
    const close = () => { dropdown.classList.add('invisible', 'opacity-0'); dropdown.classList.remove('opacity-100'); };
    close();

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !dropdown.classList.contains('invisible');
      isOpen ? close() : open();
    });
    document.addEventListener('click', close);

    menu.querySelector<HTMLButtonElement>('[data-auth-signout]')?.addEventListener('click', async () => {
      await signOut();
      writeCached(null);
      render(menu, null);
      close();
    });
  }

  async function hydrate() {
    document.querySelectorAll<HTMLElement>('[data-auth-menu]').forEach((menu) => {
      const cached = readCached();
      render(menu, cached);
      if (menu.dataset.authBound !== '1') {
        menu.dataset.authBound = '1';
        wireDropdown(menu);
      }
      fetchSession().then((session) => {
        writeCached(session);
        render(menu, session);
      });
    });
  }

  document.addEventListener('astro:page-load', hydrate);
  if (document.readyState !== 'loading') hydrate();
</script>
